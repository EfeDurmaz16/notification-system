+// The admission queue may already contain a job payload when the API cancels it.
+func TestCancelAfterJobHydrationMakesZeroProviderPOSTs(t *testing.T) {
+	s := testStore(t)
+	ctx := t.Context()
+	id := createOne(t, s, sms())
+	hydrated, err := s.GetJob(ctx, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Cancel(ctx, id); err != nil {
+		t.Fatal(err)
+	}
+	var posts atomic.Int32
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodPost {
+			posts.Add(1)
+		}
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer provider.Close()
+	engine := delivery.Engine{Store: s, URL: provider.URL, Client: provider.Client()}
+	if err := engine.Send(ctx, hydrated); err != nil {
+		t.Fatal(err)
+	}
+	final, err := s.Get(ctx, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if final.Status != "cancelled" || final.MessageID != "" || posts.Load() != 0 {
+		t.Fatalf("after admission of cached job: status=%s, messageID=%q, POSTs=%d", final.Status, final.MessageID, posts.Load())
+	}
+}
